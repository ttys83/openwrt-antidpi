+static int get_history_by_prefix(const char *prefix, int direction)
+{
+	int i;
+	int prefix_len = strlen(prefix);
 
+	if (!(state->flags & DO_HISTORY))
+		goto not_found;
+	for (i = state->cur_history + direction;
+	     i >= 0 && i <= state->cnt_history;
+	     i += direction) {
+		/* The last slot holds the line typed before browsing history. */
+		if (i == state->cnt_history
+		 || (state->history[i]
+		  && strncmp(state->history[i], prefix, prefix_len) == 0)
+		) {
+			save_command_ps_at_cur_history();
+			state->cur_history = i;
+			return 1;
+		}
+	}
+ not_found:
+	beep();
+	return 0;
+}
